        "graphMode": "none"
      }
    },
    {
      "id": 8,
      "title": "CPU busy % - PromQL via Prometheus datasource",
      "type": "timeseries",
      "description": "Real PromQL through the Prometheus datasource. Prometheus is the query engine; the samples are read back out of ClickHouse via remote_read.",
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 16,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-local"
          },
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)",
          "legendFormat": "{{instance}}",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "CPU busy % - PromQL executed inside ClickHouse",
      "type": "timeseries",
      "description": "Same PromQL expression, but evaluated by ClickHouse itself via the prometheusQueryRange table function. No Prometheus in the query path.",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-clickstack"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-clickstack"
          },
          "pluginVersion": "4.21.2",
          "editorType": "sql",
          "rawSql": "SELECT\n  t.1 AS time,\n  t.2 AS cpu_busy_pct\nFROM prometheusQueryRange(\n    prom.metrics,\n    '100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)',\n    $__fromTime,\n    $__toTime,\n    30\n)\nARRAY JOIN time_series AS t\nORDER BY time",
          "format": 0,
          "queryType": "timeseries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "ClickHouse queries/sec - PromQL inside ClickHouse",
      "type": "timeseries",
      "description": "ClickHouse scraping its own /metrics endpoint, stored in ClickHouse, queried with PromQL in ClickHouse.",
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-clickstack"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-clickstack"
          },
          "pluginVersion": "4.21.2",
          "editorType": "sql",
          "rawSql": "SELECT\n  t.1 AS time,\n  arrayFilter(x -> (x.1 = 'instance'), tags)[1].2 AS instance,\n  t.2 AS queries_per_sec\nFROM prometheusQueryRange(\n    prom.metrics,\n    'rate(ClickHouseProfileEvents_Query[2m])',\n    $__fromTime,\n    $__toTime,\n    30\n)\nARRAY JOIN time_series AS t\nORDER BY time",
          "format": 0,
          "queryType": "timeseries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}